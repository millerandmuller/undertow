{
  "name": "undertow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "login": "node --env-file-if-exists=.env src/cli.ts login",
    "probe": "node --env-file-if-exists=.env src/cli.ts probe",
    "watch": "node --env-file-if-exists=.env src/cli.ts watch",
    "restore": "node --env-file-if-exists=.env src/cli.ts restore",
    "loadtest": "node --env-file-if-exists=.env src/cli.ts loadtest",
    "report": "node --env-file-if-exists=.env src/cli.ts report",
    "replay": "node --env-file-if-exists=.env src/cli.ts replay",
    "check": "node scripts/check.mjs"
  }
}
